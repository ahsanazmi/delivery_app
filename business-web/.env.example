VITE_API_BASE_URL=http://localhost:8000

# Maps & Location System Phase 10 — Restaurant Location Map. MapLibre GL JS
# style URL, free/open-source, no API key required. Defaults to CARTO's free
# Voyager basemap style (https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json)
# if unset — free for commercial use up to 1,000,000 tile requests/month
# (fair use; CARTO typically raises the limit on request rather than cutting
# off). Keyless requests may be watermarked; get a free CARTO account/API key
# before real production use. Required attribution ("© CARTO, © OpenStreetMap
# contributors") is rendered on the map automatically — do not remove it if
# you swap this URL. Same provider used by customer-mobile's map picker and
# live rider tracking, kept consistent across the platform. Override this to
# point at a different MapLibre-compatible style/tile provider later without
# touching any code (see src/features/restaurant/map-tile-config.ts).
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
