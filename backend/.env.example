ENVIRONMENT=development
# Must be false in any deployment with ENVIRONMENT=production — the app
# refuses to start otherwise (see app/core/config.py).
DEBUG=false
# Server-side only, never sent to a client. WARNING by default; INFO also
# surfaces admin-action log lines (the DB-backed AdminAuditLog remains the
# authoritative record regardless of this setting).
LOG_LEVEL=WARNING
DATABASE_URL=postgresql+psycopg://say_hi_chai:say_hi_chai@localhost:5433/say_hi_chai
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Online payment verification (Razorpay) — leave blank to keep online
# payments disabled; verify_payment() then honestly refuses to verify
# anything (503) rather than fabricating a successful payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Comma-separated browser origins allowed to call this API — business-web
# (Restaurant Owner Portal, port 5173) and admin-web (Admin Portal, port
# 5180; this was 5174 in earlier drafts before admin-web settled on its
# own dev port, so this line must stay in sync with admin-web's actual
# `npm run dev -- --port` value, not just the two web apps' Vite defaults).
CORS_ORIGINS=http://localhost:5173,http://localhost:5180,http://127.0.0.1:5173,http://127.0.0.1:5180
