ENVIRONMENT=development
# Must be false in any deployment with ENVIRONMENT=production — the app
# refuses to start otherwise (see app/core/config.py).
DEBUG=false
# Server-side only, never sent to a client. WARNING by default; INFO also
# surfaces admin-action log lines (the DB-backed AdminAuditLog remains the
# authoritative record regardless of this setting).
LOG_LEVEL=WARNING
DATABASE_URL=postgresql+psycopg://say_hi_chai:say_hi_chai@localhost:5433/say_hi_chai
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Online payment verification (Razorpay) — leave blank to keep online
# payments disabled; verify_payment() then honestly refuses to verify
# anything (503) rather than fabricating a successful payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional — Expo push notifications work with no credential at all.
# Setting this only raises Expo's own rate limits (see ExpoPushProvider).
EXPO_ACCESS_TOKEN=
# Comma-separated browser origins allowed to call this API — business-web
# (Restaurant Owner Portal, port 5173) and admin-web (Admin Portal, port
# 5180; this was 5174 in earlier drafts before admin-web settled on its
# own dev port, so this line must stay in sync with admin-web's actual
# `npm run dev -- --port` value, not just the two web apps' Vite defaults).
CORS_ORIGINS=http://localhost:5173,http://localhost:5180,http://127.0.0.1:5173,http://127.0.0.1:5180
# Maps & Location System Phase 8/9 — Reverse Geocoding and Forward
# Geocoding / Address Search. Photon (open-source, OSM-based), not
# Google Places/Geocoding. This is the *root* URL — forward search lives
# under it at /api/, reverse geocoding at the sibling path /reverse (not
# nested under /api/ at all, confirmed against the real public
# instance). Leave blank to use komoot's free public instance
# (rate-limited to 1 req/s, throttled server-side in location_search.py,
# shared by both forward and reverse calls); point at a self-hosted
# Photon instance's root URL to remove that limit.
PHOTON_API_BASE_URL=https://photon.komoot.io

# Maps & Location System Phase 17 — Routes Foundation. OSRM (open-source,
# OSM-based), not Google Routes API. Leave blank to use project-osrm.org's
# free public demo server (rate-limited to 1 req/s, throttled server-side
# in routing.py); its usage policy restricts it to non-commercial use, so
# point this at a self-hosted OSRM instance (a regional OSM extract, not
# the whole planet) before real production traffic.
OSRM_API_BASE_URL=https://router.project-osrm.org

# Live Rider Tracking — all of the below have sane defaults (see
# app/core/config.py) and only need to be set here to override them; see
# docs/live-tracking-architecture.md for the reasoning behind each number.
#
# Location Update Throttling (Phase 7) — a new RiderLocationPing history
# row is written once EITHER this much time OR this much movement has
# passed since the last stored one, whichever comes first. The rider's
# "latest position" cache (read by every consumer) is still updated on
# every accepted call regardless of this throttle.
RIDER_LOCATION_MIN_INTERVAL_SECONDS=10
RIDER_LOCATION_MIN_MOVEMENT_METERS=15.0
# GPS Accuracy/Jump Filtering (Phase 8) — an update is only rejected as an
# implausible jump when its own accuracy is worse than this AND the
# implied speed to reach it exceeds the plausible-speed ceiling, never on
# either alone.
RIDER_LOCATION_MAX_ACCEPTED_ACCURACY_METERS=100.0
RIDER_LOCATION_MAX_PLAUSIBLE_SPEED_MPS=55.0
# Timestamp Validation (Phase 6/8) — a client-claimed capture time further
# from the server's own clock than this, in either direction, is rejected
# outright rather than silently substituted.
RIDER_LOCATION_MAX_TIMESTAMP_AGE_SECONDS=3600
RIDER_LOCATION_MAX_TIMESTAMP_FUTURE_SECONDS=60
# Stale-Location Detection (Phase 5/19) — a rider's last-known position is
# LIVE under the first threshold, STALE between the two, OFFLINE past the
# second — the same computed `state` every client (customer app, this
# codebase's own docs) renders identically from.
RIDER_LOCATION_STALE_AFTER_SECONDS=30
RIDER_LOCATION_OFFLINE_AFTER_SECONDS=120
# Live ETA / Route Refresh Strategy (Phase 22–24) — a live ETA is only
# recomputed (a real OSRM call) once this much time OR this much movement
# has passed for that order, never on every single GPS ping.
LIVE_ETA_MIN_REFRESH_SECONDS=60
LIVE_ETA_MIN_MOVEMENT_METERS=300.0
# "Rider is approaching" Notification (Phase 34) — the straight-line
# distance to the delivery address, while OUT_FOR_DELIVERY, that triggers
# this one-time-per-order push notification.
RIDER_APPROACHING_DISTANCE_KM=0.5
