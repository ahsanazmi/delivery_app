# Optional override. Leave blank to auto-detect the host from Expo.
EXPO_PUBLIC_API_BASE_URL=

# Maps & Location System Phase 21 — Rider Map Foundation. MapLibre Native,
# not Google Maps — same free/open-source stack as every other map on this
# platform. Full MapLibre *style JSON* URL, not just a tile URL. Leave
# blank to use CARTO's free Voyager style (fair use up to 1,000,000 tile
# requests/month; keyless requests may be watermarked — get a free CARTO
# account before real production use). See
# features/location/map-tile-config.ts.
EXPO_PUBLIC_MAP_STYLE_URL=
