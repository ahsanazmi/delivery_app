VITE_API_BASE_URL=http://localhost:8000

# Maps & Location System Phase 11 — Admin Location Visibility. MapLibre GL JS
# style URL, free/open-source, no API key required. Defaults to CARTO's free
# Voyager basemap style if unset — free for commercial use up to 1,000,000
# tile requests/month (fair use). Keyless requests may be watermarked; get a
# free CARTO account/API key before real production use. Required
# attribution ("© CARTO, © OpenStreetMap contributors") is rendered on the
# map automatically. Same provider used by business-web's restaurant
# location map and the mobile apps, kept consistent across the platform.
# Override to point at a different MapLibre-compatible style/tile provider
# later without touching any code (see src/features/location/map-tile-config.ts).
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
