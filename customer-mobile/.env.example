# Optional override. Leave blank to auto-detect the host from Expo.
EXPO_PUBLIC_API_BASE_URL=

# Live Rider Location Tracking — the rider-tracking map (app/track/[id].tsx)
# uses MapLibre Native, not react-native-maps/Google, specifically to
# avoid any Google Maps dependency. The customer map picker
# (app/addresses/map-picker.tsx) was migrated onto this same stack too,
# so no Google Maps API key is needed anywhere in this app any more.
# This is a runtime EXPO_PUBLIC_*
# variable (read by features/tracking/map-tile-config.ts in the JS
# bundle, not baked into a native build) — a full MapLibre *style JSON*
# URL, not just a tile URL, so the entire look of the basemap swaps
# with it, not just the raw tiles.
#
# Default (used when left blank): CARTO's free Voyager style —
# https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
# Free for commercial use up to 1,000,000 tile requests/month (fair use;
# CARTO typically raises the limit on request rather than cutting you
# off). Requires attribution, already rendered on-map by RiderMap.tsx:
# "© CARTO, © OpenStreetMap contributors". Keyless requests may be
# watermarked by CARTO — sign up for a free CARTO account and API key
# before real production use to remove it; see
# https://carto.com/legal/basemap-terms/ for the exact terms.
#
# To switch providers later (Stadia Maps, MapTiler, self-hosted, or a
# keyed CARTO URL), just change this one value — no code change needed,
# by design (see this variable's own consumer for the "why").
EXPO_PUBLIC_MAP_STYLE_URL=
